<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Dashboard - GP Connect</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link href="/css/styles.css" rel="stylesheet">
  <style>
    :root {
      --primary: #4a6fa5;
      --secondary: #166088;
      --accent: #4fc3f7;
      --light: #f8f9fa;
      --dark: #212529;
    }

    body {
      font-family: 'Poppins', sans-serif;
      background-color: var(--light);
      overflow-x: hidden;
    }

    .section-title {
      position: relative;
      display: inline-block;
      margin-bottom: 2.5rem;
      font-weight: 600;
      color: var(--primary);
    }

    .section-title::after {
      content: '';
      position: absolute;
      bottom: -10px;
      left: 50%;
      transform: translateX(-50%);
      width: 80px;
      height: 4px;
      background-color: var(--accent);
      border-radius: 2px;
    }

    .card {
      border: none;
      border-radius: 16px;
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.1);
      transition: transform 0.3s ease, box-shadow 0.3s ease;
      background-color: white;
    }

    body.modal-open .card {
      transition: none;
    }

    .card:hover {
      transform: translateY(-8px);
      box-shadow: 0 12px 30px rgba(0, 0, 0, 0.15);
    }

    body.modal-open .card:hover {
      transform: none;
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.1);
    }

    .btn-primary {
      background-color: var(--primary);
      border-color: var(--primary);
      padding: 0.75rem 1.5rem;
      font-weight: 500;
      border-radius: 8px;
      transition: background-color 0.3s ease;
    }

    .btn-primary:hover {
      background-color: var(--secondary);
      border-color: var(--secondary);
    }

    .btn-success,
    .btn-danger,
    .btn-warning {
      border-radius: 8px;
      padding: 0.5rem 1.25rem;
      font-weight: 500;
    }

    .alert {
      border-radius: 10px;
      border-left: 5px solid;
      padding: 1rem;
      margin-bottom: 2rem;
    }

    .alert-warning {
      border-color: #ffca2c;
      background-color: #fff3cd;
    }

    .alert-danger {
      border-color: #dc3545;
      background-color: #f8d7da;
    }

    .alert-success {
      border-color: #28a745;
      background-color: #d4edda;
    }

    .item-card {
      border-radius: 12px;
      padding: 1.5rem;
      background-color: #fff;
      margin-bottom: 1.5rem;
      border-left: 4px solid var(--accent);
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    body.modal-open .item-card {
      transition: none;
    }

    .item-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
    }

    body.modal-open .item-card:hover {
      transform: none;
      box-shadow: none;
    }

    .item-header {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin-bottom: 1rem;
    }

    .item-header i {
      font-size: 1.8rem;
      color: var(--primary);
    }

    .item-header h6 {
      margin: 0;
      font-weight: 600;
      color: var(--dark);
    }

    .badge {
      border-radius: 12px;
      padding: 0.5rem 1rem;
      font-weight: 500;
    }

    .star-rating .fa-star {
      color: #ffca2c;
      font-size: 1.2rem;
    }

    .star-rating .fa-regular.fa-star {
      color: #ced4da;
      font-size: 1.2rem;
    }

    .section-container {
      background: linear-gradient(135deg, rgba(74, 111, 165, 0.05), rgba(22, 96, 136, 0.05));
      padding: 2rem;
      border-radius: 16px;
      margin-bottom: 2rem;
    }

    .fade-in {
      animation: fadeIn 0.5s ease-in;
    }

    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(10px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .form-control,
    .form-select {
      border-radius: 8px;
      border: 1px solid #ced4da;
      padding: 0.75rem;
      font-size: 0.95rem;
    }

    .form-control:focus,
    .form-select:focus {
      border-color: var(--primary);
      box-shadow: 0 0 0 0.2rem rgba(74, 111, 165, 0.25);
    }

    .form-label {
      font-weight: 500;
      color: var(--dark);
    }

    .modal-content {
      border-radius: 12px;
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.15);
    }

    .modal-header {
      background-color: var(--primary);
      color: white;
      border-top-left-radius: 12px;
      border-top-right-radius: 12px;
    }

    /* High Contrast Overrides */
    .high-contrast body {
      background-color: #000000 !important;
      color: #ffffff !important;
    }

    .high-contrast .section-title {
      color: #ffffff !important;
    }

    .high-contrast .section-title::after {
      background-color: #ffff00 !important;
    }

    .high-contrast .card {
      background-color: #000000 !important;
      border: 2px solid #ffffff !important;
      color: #ffffff !important;
      box-shadow: none !important;
    }

    .high-contrast .card-header {
      background-color: #0000ff !important;
      color: #ffffff !important;
      border-bottom: 2px solid #ffffff !important;
    }

    .high-contrast .btn-primary {
      background-color: #0000ff !important;
      border-color: #ffffff !important;
      color: #ffffff !important;
    }

    .high-contrast .btn-primary:hover {
      background-color: #000099 !important;
      color: #ffff00 !important;
    }

    .high-contrast .btn-success {
      background-color: #008000 !important;
      border-color: #ffffff !important;
      color: #ffffff !important;
    }

    .high-contrast .btn-success:hover {
      background-color: #006600 !important;
      color: #ffff00 !important;
    }

    .high-contrast .btn-danger {
      background-color: #ff0000 !important;
      border-color: #ffffff !important;
      color: #ffffff !important;
    }

    .high-contrast .btn-danger:hover {
      background-color: #cc0000 !important;
      color: #ffff00 !important;
    }

    .high-contrast .btn-warning {
      background-color: #ffa500 !important;
      border-color: #ffffff !important;
      color: #ffffff !important;
    }

    .high-contrast .btn-warning:hover {
      background-color: #cc8400 !important;
      color: #ffff00 !important;
    }

    .high-contrast .alert {
      background-color: #000000 !important;
      color: #ffffff !important;
      border: 2px solid #ffffff !important;
    }

    .high-contrast .alert-warning {
      border-color: #ffa500 !important;
    }

    .high-contrast .alert-danger {
      border-color: #ff0000 !important;
    }

    .high-contrast .alert-success {
      border-color: #008000 !important;
    }

    .high-contrast .alert-link {
      color: #00b7eb !important;
    }

    .high-contrast .alert-link:hover {
      color: #ffff00 !important;
      text-decoration: underline;
      text-decoration-color: #ffff00;
      text-decoration-thickness: 2px;
    }

    .high-contrast .item-card {
      background-color: #000000 !important;
      border: 2px solid #ffffff !important;
      color: #ffffff !important;
    }

    .high-contrast .item-header i {
      color: #00b7eb !important;
    }

    .high-contrast .item-header h6 {
      color: #ffffff !important;
    }

    .high-contrast .badge {
      border: 1px solid #ffffff !important;
    }

    .high-contrast .badge.bg-success {
      background-color: #008000 !important;
      color: #ffffff !important;
    }

    .high-contrast .badge.bg-secondary {
      background-color: #666666 !important;
      color: #ffffff !important;
    }

    .high-contrast .badge.bg-warning {
      background-color: #ffa500 !important;
      color: #ffffff !important;
    }

    .high-contrast .badge.bg-danger {
      background-color: #ff0000 !important;
      color: #ffffff !important;
    }

    .high-contrast .star-rating .fa-star {
      color: #ffff00 !important;
    }

    .high-contrast .star-rating .fa-regular.fa-star {
      color: #666666 !important;
    }

    .high-contrast .section-container {
      background: #000000 !important;
      border: 2px solid #ffffff !important;
    }

    .high-contrast .form-control,
    .high-contrast .form-select {
      background-color: #000000 !important;
      color: #ffffff !important;
      border: 2px solid #ffffff !important;
    }

    .high-contrast .form-control:focus,
    .high-contrast .form-select:focus {
      border-color: #ffff00 !important;
      box-shadow: none !important;
    }

    .high-contrast .form-label {
      color: #ffffff !important;
    }

    .high-contrast .modal-content {
      background-color: #000000 !important;
      border: 2px solid #ffffff !important;
    }

    .high-contrast .modal-header {
      background-color: #0000ff !important;
      color: #ffffff !important;
      border-bottom: 2px solid #ffffff !important;
    }

    .high-contrast .btn-close {
      filter: invert(1) !important;
      /* Ensure visibility */
    }

    .high-contrast a {
      color: #00b7eb !important;
    }

    .high-contrast a:hover {
      color: #ffff00 !important;
      text-decoration: underline;
      text-decoration-color: #ffff00;
      text-decoration-thickness: 2px;
    }

    .high-contrast .text-muted {
      color: #ffffff !important;
    }

    .high-contrast .bg-light {
      background-color: #000000 !important;
      border: 2px solid #ffffff !important;
    }
  </style>
  <script>
    // Check for high contrast mode in localStorage and apply styles
    document.addEventListener('DOMContentLoaded', () => {
      if (localStorage.getItem('highContrast') === 'true') {
        document.body.classList.add('high-contrast');
        document.body.style.backgroundColor = '#000000';
        console.log('High contrast mode enabled: body background set to #000000');
      }
    });
  </script>
</head>
<script>
  // Check for high contrast mode in localStorage and apply styles
  document.addEventListener('DOMContentLoaded', () => {
    if (localStorage.getItem('highContrast') === 'true') {
      document.body.classList.add('high-contrast');
      document.body.style.backgroundColor = '#000000';
      console.log('High contrast mode enabled: body background set to #000000');
    }
  });
</script>

<body>
  <%- include('partials/header') %>
    <main class="container py-5">
      <h2 class="text-center section-title mb-5">Admin Dashboard</h2>

      <% if (!user || user.role !=='admin' ) { %>
        <div class="alert alert-warning fade-in" role="alert">
          <i class="fas fa-exclamation-triangle me-2"></i>
          Access denied. Please <a href="/login" class="alert-link">log in</a> as an admin.
        </div>
        <% } else { %>
          <% if (error) { %>
            <div class="alert alert-danger fade-in" role="alert">
              <i class="fas fa-times-circle me-2"></i>
              <%= error %>
            </div>
            <% } %>
              <% if (success) { %>
                <div class="alert alert-success fade-in" role="alert">
                  <i class="fas fa-check-circle me-2"></i>
                  <%= success %>
                </div>
                <% } %>

                  <!-- Manage GPs and Appointments -->
                  <div class="section-container">
                    <div class="card shadow mb-5">
                      <div class="card-header bg-light">
                        <h5 class="mb-0"><i class="fas fa-user-md me-2"></i>Manage GPs and Appointments</h5>
                      </div>
                      <div class="card-body">
                        <!-- Add New GP Form -->
                        <h6 class="section-title mb-4">Add New GP</h6>
                        <form method="POST" action="/api/admin/add-gp" class="mb-4">
                          <div class="row g-3">
                            <div class="col-md-6">
                              <label for="gp_name" class="form-label">GP Name</label>
                              <input type="text" class="form-control" id="gp_name" name="gp_name" required>
                            </div>
                            <div class="col-md-6">
                              <label for="practice_id" class="form-label">Practice</label>
                              <select class="form-select" id="practice_id" name="practice_id" required>
                                <option value="" disabled selected>Select a practice</option>
                                <% (practices || []).forEach(practice=> { %>
                                  <option value="<%= practice.id %>">
                                    <%= practice.name %> - <%= practice.city %>
                                  </option>
                                  <% }) %>
                              </select>
                            </div>
                            <div class="col-12">
                              <button type="submit" class="btn btn-primary" title="Add a new GP"><i
                                  class="fas fa-plus me-1"></i>Add GP</button>
                            </div>
                          </div>
                        </form>

                        <!-- List of GPs -->
                        <h6 class="section-title mb-4">Current GPs</h6>
                        <% if ((gps || []).length> 0) { %>
                          <div class="row g-4">
                            <% gps.forEach(gp=> { %>
                              <div class="col-md-6 col-lg-4">
                                <div class="item-card fade-in">
                                  <div class="item-header">
                                    <i class="fas fa-user-md"></i>
                                    <h6>
                                      <%= gp.name %>
                                    </h6>
                                  </div>
                                  <p><i class="fas fa-clinic-medical me-2"></i><strong>Practice:</strong>
                                    <%= gp.practice_name %> - <%= gp.city %>
                                  </p>
                                  <div class="d-flex gap-2">
                                    <button class="btn btn-warning btn-sm" data-bs-toggle="modal"
                                      data-bs-target="#editGpModal<%= gp.id %>" title="Edit this GP"><i
                                        class="fas fa-edit me-1"></i>Edit</button>
                                    <form method="POST" action="/api/admin/delete-gp"
                                      onsubmit="return confirm('Are you sure you want to delete <%= gp.name %>? This cannot be undone.');"
                                      class="d-inline">
                                      <input type="hidden" name="gp_id" value="<%= gp.id %>">
                                      <button type="submit" class="btn btn-danger btn-sm" title="Delete this GP"><i
                                          class="fas fa-trash me-1"></i>Delete</button>
                                    </form>
                                  </div>
                                </div>
                              </div>
                              <!-- Edit GP Modal -->
                              <div class="modal fade" id="editGpModal<%= gp.id %>" tabindex="-1"
                                aria-labelledby="editGpModalLabel<%= gp.id %>" aria-hidden="true">
                                <div class="modal-dialog">
                                  <div class="modal-content">
                                    <div class="modal-header">
                                      <h5 class="modal-title" id="editGpModalLabel<%= gp.id %>">Edit GP: <%= gp.name %>
                                      </h5>
                                      <button type="button" class="btn-close" data-bs-dismiss="modal"
                                        aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body">
                                      <form method="POST" action="/api/admin/edit-gp">
                                        <input type="hidden" name="gp_id" value="<%= gp.id %>">
                                        <div class="mb-3">
                                          <label for="edit_gp_name_<%= gp.id %>" class="form-label">GP Name</label>
                                          <input type="text" class="form-control" id="edit_gp_name_<%= gp.id %>"
                                            name="gp_name" value="<%= gp.name %>" required>
                                        </div>
                                        <div class="mb-3">
                                          <label for="edit_practice_id_<%= gp.id %>" class="form-label">Practice</label>
                                          <select class="form-select" id="edit_practice_id_<%= gp.id %>"
                                            name="practice_id" required>
                                            <% (practices || []).forEach(practice=> { %>
                                              <option value="<%= practice.id %>" <%=practice.id===gp.practice_id
                                                ? 'selected' : '' %>><%= practice.name %> - <%= practice.city %>
                                              </option>
                                              <% }) %>
                                          </select>
                                        </div>
                                        <button type="submit" class="btn btn-primary"><i
                                            class="fas fa-save me-1"></i>Save Changes</button>
                                      </form>
                                    </div>
                                  </div>
                                </div>
                              </div>
                              <% }) %>
                          </div>
                          <% } else { %>
                            <p class="text-muted"><i class="fas fa-info-circle me-2"></i>No GPs available.</p>
                            <% } %>

                              <!-- Add New Appointment Form -->
                              <h6 class="section-title mb-4 mt-5">Add New Appointment</h6>
                              <form method="POST" action="/api/admin/add-appointment" class="mb-4">
                                <div class="row g-3">
                                  <div class="col-md-4">
                                    <label for="gp_id" class="form-label">GP</label>
                                    <select class="form-select" id="gp_id" name="gp_id" required>
                                      <option value="" disabled selected>Select a GP</option>
                                      <% (gps || []).forEach(gp=> { %>
                                        <option value="<%= gp.id %>">
                                          <%= gp.name %>
                                        </option>
                                        <% }) %>
                                    </select>
                                  </div>
                                  <div class="col-md-4">
                                    <label for="start_time" class="form-label">Start Time</label>
                                    <input type="datetime-local" class="form-control" id="start_time" name="start_time"
                                      min="<%= new Date().toISOString().slice(0, 16) %>" required>
                                  </div>
                                  <div class="col-md-4">
                                    <label for="end_time" class="form-label">End Time</label>
                                    <input type="datetime-local" class="form-control" id="end_time" name="end_time"
                                      min="<%= new Date().toISOString().slice(0, 16) %>" required>
                                  </div>
                                  <div class="col-12">
                                    <button type="submit" class="btn btn-primary" title="Add a new appointment"><i
                                        class="fas fa-plus me-1"></i>Add Appointment</button>
                                  </div>
                                </div>
                              </form>

                              <!-- List of Available Appointments -->
                              <h6 class="section-title mb-4">Available Appointments</h6>
                              <% if ((appointments || []).length> 0) { %>
                                <div class="row g-4">
                                  <% appointments.forEach(appt=> { %>
                                    <div class="col-md-6 col-lg-4">
                                      <div class="item-card fade-in">
                                        <div class="item-header">
                                          <i class="fas fa-calendar-alt"></i>
                                          <h6>
                                            <%= appt.gp_name %>
                                          </h6>
                                        </div>
                                        <p><i class="fas fa-clock me-2"></i><strong>Start:</strong>
                                          <%= new Date(appt.start_time).toLocaleString() %>
                                        </p>
                                        <p><i class="fas fa-clock me-2"></i><strong>End:</strong>
                                          <%= new Date(appt.end_time).toLocaleString() %>
                                        </p>
                                        <p><i class="fas fa-clinic-medical me-2"></i><strong>Practice:</strong>
                                          <%= appt.practice_name %> - <%= appt.city %>
                                        </p>
                                        <p><span class="badge <%= appt.is_booked ? 'bg-success' : 'bg-secondary' %>"><i
                                              class="fas <%= appt.is_booked ? 'fa-check' : 'fa-times' %> me-1"></i>
                                            <%= appt.is_booked ? 'Booked' : 'Available' %>
                                          </span></p>
                                        <% if (!appt.is_booked) { %>
                                          <div class="d-flex gap-2">
                                            <button class="btn btn-warning btn-sm" data-bs-toggle="modal"
                                              data-bs-target="#editApptModal<%= appt.id %>"
                                              title="Edit this appointment"><i
                                                class="fas fa-edit me-1"></i>Edit</button>
                                            <form method="POST" action="/api/admin/delete-appointment"
                                              onsubmit="return confirm('Are you sure you want to delete this appointment? This cannot be undone.');"
                                              class="d-inline">
                                              <input type="hidden" name="appointment_id" value="<%= appt.id %>">
                                              <button type="submit" class="btn btn-danger btn-sm"
                                                title="Delete this appointment"><i
                                                  class="fas fa-trash me-1"></i>Delete</button>
                                            </form>
                                          </div>
                                          <% } %>
                                      </div>
                                    </div>
                                    <!-- Edit Appointment Modal -->
                                    <div class="modal fade" id="editApptModal<%= appt.id %>" tabindex="-1"
                                      aria-labelledby="editApptModalLabel<%= appt.id %>" aria-hidden="true">
                                      <div class="modal-dialog">
                                        <div class="modal-content">
                                          <div class="modal-header">
                                            <h5 class="modal-title" id="editApptModalLabel<%= appt.id %>">Edit
                                              Appointment: <%= appt.gp_name %>
                                            </h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal"
                                              aria-label="Close"></button>
                                          </div>
                                          <div class="modal-body">
                                            <form method="POST" action="/api/admin/edit-appointment">
                                              <input type="hidden" name="appointment_id" value="<%= appt.id %>">
                                              <div class="mb-3">
                                                <label for="edit_gp_id_<%= appt.id %>" class="form-label">GP</label>
                                                <select class="form-select" id="edit_gp_id_<%= appt.id %>" name="gp_id"
                                                  required>
                                                  <% (gps || []).forEach(gp=> { %>
                                                    <option value="<%= gp.id %>" <%=gp.id===appt.gp_id ? 'selected' : ''
                                                      %>><%= gp.name %>
                                                    </option>
                                                    <% }) %>
                                                </select>
                                              </div>
                                              <div class="mb-3">
                                                <label for="edit_start_time_<%= appt.id %>" class="form-label">Start
                                                  Time</label>
                                                <input type="datetime-local" class="form-control"
                                                  id="edit_start_time_<%= appt.id %>" name="start_time"
                                                  value="<%= new Date(appt.start_time).toISOString().slice(0, 16) %>"
                                                  required>
                                              </div>
                                              <div class="mb-3">
                                                <label for="edit_end_time_<%= appt.id %>" class="form-label">End
                                                  Time</label>
                                                <input type="datetime-local" class="form-control"
                                                  id="edit_end_time_<%= appt.id %>" name="end_time"
                                                  value="<%= new Date(appt.end_time).toISOString().slice(0, 16) %>"
                                                  required>
                                              </div>
                                              <button type="submit" class="btn btn-primary"><i
                                                  class="fas fa-save me-1"></i>Save Changes</button>
                                            </form>
                                          </div>
                                        </div>
                                      </div>
                                    </div>
                                    <% }) %>
                                </div>
                                <% } else { %>
                                  <p class="text-muted"><i class="fas fa-info-circle me-2"></i>No available
                                    appointments.</p>
                                  <% } %>
                      </div>
                    </div>
                  </div>

                  <!-- Swap Requests -->
                  <div class="section-container">
                    <div class="card shadow mb-5">
                      <div class="card-header bg-light">
                        <h5 class="mb-0"><i class="fas fa-exchange-alt me-2"></i>Swap Requests</h5>
                      </div>
                      <div class="card-body">
                        <% if ((swapRequests || []).length> 0) { %>
                          <div class="row g-4">
                            <% swapRequests.forEach(request=> { %>
                              <div class="col-md-6 col-lg-4">
                                <div class="item-card fade-in">
                                  <div class="item-header">
                                    <i class="fas fa-user"></i>
                                    <h6>
                                      <%= request.user_name %>
                                    </h6>
                                  </div>
                                  <p><i class="fas fa-calendar me-2"></i><strong>Current Appointment:</strong></p>
                                  <p><i class="fas fa-user-md me-2"></i><strong>GP:</strong> <%= request.current_gp_name %></p>
                                  <p><i class="fas fa-clinic-medical me-2"></i><strong>Practice:</strong> <%= request.current_practice_name %> - <%= request.current_city %></p>
                                  <p><i class="fas fa-clock me-2"></i><strong>Time:</strong> <%= new Date(request.current_start).toLocaleString() %></p>
                                  <p><i class="fas fa-calendar-check me-2"></i><strong>Target Appointment:</strong></p>
                                  <p><i class="fas fa-user-md me-2"></i><strong>GP:</strong> <%= request.target_gp_name %></p>
                                  <p><i class="fas fa-clinic-medical me-2"></i><strong>Practice:</strong> <%= request.target_practice_name %> - <%= request.target_city %></p>
                                  <p><i class="fas fa-clock me-2"></i><strong>Time:</strong> <%= new Date(request.target_start).toLocaleString() %></p>
                                  <p>
                                    <span
                                      class="badge <%= request.status === 'pending' ? 'bg-warning text-dark' : request.status === 'approved' ? 'bg-success' : 'bg-danger' %>">
                                      <i
                                        class="fas <%= request.status === 'pending' ? 'fa-clock' : request.status === 'approved' ? 'fa-check' : 'fa-times' %> me-1"></i>
                                      <%= request.status %>
                                    </span>
                                  </p>
                                  <% if (request.status==='pending' ) { %>
                                    <div class="d-flex gap-2 mt-2">
                                      <form method="POST" action="/api/admin/approve-swap" class="d-inline">
                                        <input type="hidden" name="request_id" value="<%= request.id %>">
                                        <button type="submit" class="btn btn-success btn-sm"
                                          title="Approve this swap request"><i
                                            class="fas fa-check me-1"></i>Approve</button>
                                      </form>
                                      <form method="POST" action="/api/admin/reject-swap" class="d-inline">
                                        <input type="hidden" name="request_id" value="<%= request.id %>">
                                        <button type="submit" class="btn btn-danger btn-sm"
                                          title="Reject this swap request"><i
                                            class="fas fa-times me-1"></i>Reject</button>
                                      </form>
                                    </div>
                                    <% } %>
                                </div>
                              </div>
                              <% }) %>
                          </div>
                          <% } else { %>
                            <p class="text-muted"><i class="fas fa-info-circle me-2"></i>No swap requests available.</p>
                            <% } %>
                      </div>
                    </div>
                  </div>

                  <!-- Feedback -->
                  <div class="section-container">
                    <div class="card shadow">
                      <div class="card-header bg-light">
                        <h5 class="mb-0"><i class="fas fa-star me-2"></i>Feedback</h5>
                      </div>
                      <div class="card-body">
                        <% if ((feedback || []).length> 0) { %>
                          <div class="row g-4">
                            <% feedback.forEach(fb=> { %>
                              <div class="col-md-6 col-lg-4">
                                <div class="item-card fade-in">
                                  <div class="item-header">
                                    <i class="fas fa-user"></i>
                                    <h6>
                                      <%= fb.user_name %>
                                    </h6>
                                  </div>
                                  <p><i class="fas fa-calendar-alt me-2"></i><strong>Appointment:</strong>
                                    <%= fb.gp_name %> - <%= new Date(fb.start_time).toLocaleString() %>
                                  </p>
                                  <p>
                                    <strong>Rating:</strong>
                                    <span class="star-rating">
                                      <% for (let i=1; i <=5; i++) { %>
                                        <i class="fa-star <%= i <= fb.rating ? 'fas' : 'far' %>"></i>
                                        <% } %>
                                    </span>
                                  </p>
                                  <p><i class="fas fa-comment me-2"></i><strong>Comments:</strong>
                                    <%= fb.comments || 'No comments' %>
                                  </p>
                                </div>
                              </div>
                              <% }) %>
                          </div>
                          <% } else { %>
                            <p class="text-muted"><i class="fas fa-info-circle me-2"></i>No feedback available.</p>
                            <% } %>
                      </div>
                    </div>
                  </div>
                  <% } %>
    </main>
    <%- include('partials/footer') %>
      <script>
        // Apply high contrast mode from localStorage
        document.addEventListener('DOMContentLoaded', () => {
          if (localStorage.getItem('highContrast') === 'true') {
            document.body.classList.add('high-contrast');
          }
        });

        // Initialize tooltips only for elements outside modals
        const tooltipTriggerList = document.querySelectorAll('[data-bs-toggle="tooltip"]:not(.modal *)');
        const tooltipList = [...tooltipTriggerList].map(tooltipTriggerEl => new bootstrap.Tooltip(tooltipTriggerEl));

        // Ensure date inputs are restricted to future dates
        const startTimeInput = document.getElementById('start_time');
        const endTimeInput = document.getElementById('end_time');
        if (startTimeInput && endTimeInput) {
          startTimeInput.addEventListener('change', () => {
            endTimeInput.min = startTimeInput.value;
          });
        }

    // Handle edit appointment date inputs
    <% (appointments || []).forEach(appt => { %>
      const editStartTime_<%= appt.id %> = document.getElementById('edit_start_time_<%= appt.id %>');
          const editEndTime_<%= appt.id %> = document.getElementById('edit_end_time_<%= appt.id %>');
          if (editStartTime_ <%= appt.id %> && editEndTime_ <%= appt.id %>) {
          editStartTime_ <%= appt.id %>.addEventListener('change', () => {
            editEndTime_ <%= appt.id %>.min = editStartTime_ <%= appt.id %>.value;
          });
        }
    <% }) %>
      </script>
</body>

</html>