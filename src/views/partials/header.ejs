<!-- Bootstrap JS and Contrast Mode Script -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
  // Contrast Mode Toggle and Dropdown Background
  document.addEventListener('DOMContentLoaded', () => {
    const toggleButton = document.getElementById('highContrastToggle');
    const body = document.body;
    const dropdownMenus = document.querySelectorAll('.dropdown-menu');
    const isHighContrast = localStorage.getItem('highContrast') === 'true';

    // Function to update dropdown menu background
    function updateDropdownBackground() {
      const isContrastMode = body.classList.contains('high-contrast');
      dropdownMenus.forEach(menu => {
        menu.style.backgroundColor = isContrastMode ? '#ffffff' : '';
      });
    }

    // Apply contrast mode and dropdown background if saved in localStorage
    if (isHighContrast) {
      body.classList.add('high-contrast');
      toggleButton.querySelector('span').textContent = 'Normal Mode';
      updateDropdownBackground();
    }

    // Toggle contrast mode on click and reload page
    toggleButton.addEventListener('click', () => {
      body.classList.toggle('high-contrast');
      const isHighContrast = body.classList.contains('high-contrast');
      localStorage.setItem('highContrast', isHighContrast);
      toggleButton.querySelector('span').textContent = isHighContrast ? 'Normal Mode' : 'Contrast Mode';
      updateDropdownBackground();
      window.location.reload(); // Reload page to apply all styles
    });

    // Ensure dropdown background updates on dropdown toggle
    document.querySelectorAll('.dropdown-toggle').forEach(toggle => {
      toggle.addEventListener('click', updateDropdownBackground);
    });
  });
</script>