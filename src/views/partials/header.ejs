<script>
  document.addEventListener('DOMContentLoaded', () => {
    const toggleButton = document.getElementById('highContrastToggle');
    const body = document.body;
    if (!toggleButton) return;

    const updateButton = () => {
      const active = body.classList.contains('high-contrast');
      toggleButton.setAttribute('aria-pressed', String(active));
      toggleButton.querySelector('span').textContent = active ? 'Normal Mode' : 'Contrast Mode';
    };

    body.classList.toggle('high-contrast', localStorage.getItem('highContrast') === 'true');
    updateButton();

    toggleButton.addEventListener('click', () => {
      body.classList.toggle('high-contrast');
      localStorage.setItem('highContrast', String(body.classList.contains('high-contrast')));
      updateButton();
    });
  });
</script>
