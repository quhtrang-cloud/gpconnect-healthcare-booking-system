<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Success - GP Connect</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link href="/css/styles.css" rel="stylesheet">
  <style>
    :root {
      --primary: #4a6fa5;
      --secondary: #166088;
      --accent: #4fc3f7;
      --light: #f8f9fa;
      --dark: #212529;
      --success: #28a745;
    }
    body {
      font-family: 'Poppins', sans-serif;
      background-color: var(--light);
      overflow-x: hidden;
    }
    .section-title {
      position: relative;
      display: inline-block;
      margin-bottom: 2.5rem;
      font-weight: 600;
      color: var(--primary);
    }
    .section-title::after {
      content: '';
      position: absolute;
      bottom: -10px;
      left: 50%;
      transform: translateX(-50%);
      width: 80px;
      height: 4px;
      background-color: var(--accent);
      border-radius: 2px;
    }
    .card {
      border: none;
      border-radius: 16px;
      box-shadow: 0 6px 20px rgba(0,0,0,0.1);
      transition: transform 0.3s ease, box-shadow 0.3s ease;
      background-color: white;
      max-width: 600px;
      margin: 0 auto;
    }
    .card:hover {
      transform: translateY(-8px);
      box-shadow: 0 12px 30px rgba(0,0,0,0.15);
    }
    .btn-primary {
      background-color: var(--primary);
      border-color: var(--primary);
      padding: 0.75rem 1.5rem;
      font-weight: 500;
      border-radius: 8px;
      transition: background-color 0.3s ease;
    }
    .btn-primary:hover {
      background-color: var(--secondary);
      border-color: var(--secondary);
    }
    .success-icon {
      font-size: 3.5rem;
      color: var(--success);
      margin-bottom: 1.5rem;
      animation: pulse 1.5s ease-in-out infinite;
    }
    .lead {
      font-size: 1.25rem;
      color: var(--dark);
      line-height: 1.6;
    }
    .section-container {
      background: linear-gradient(135deg, rgba(74, 111, 165, 0.05), rgba(22, 96, 136, 0.05));
      padding: 2rem;
      border-radius: 16px;
      margin-bottom: 2rem;
    }
    .fade-in {
      animation: fadeIn 0.5s ease-in;
    }
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }
    @keyframes pulse {
      0% { transform: scale(1); }
      50% { transform: scale(1.1); }
      100% { transform: scale(1); }
    }
    /* High Contrast Overrides */
    .high-contrast body {
      background-color: #000000 !important;
      color: #ffffff !important;
    }
    .high-contrast .section-title {
      color: #ffffff !important;
    }
    .high-contrast .section-title::after {
      background-color: #ffff00 !important;
    }
    .high-contrast .card {
      background-color: #000000 !important;
      border: 2px solid #ffffff !important;
      color: #ffffff !important;
      box-shadow: none !important;
    }
    .high-contrast .btn-primary {
      background-color: #0000ff !important;
      border-color: #ffffff !important;
      color: #ffffff !important;
    }
    .high-contrast .btn-primary:hover {
      background-color: #000099 !important;
      color: #ffff00 !important;
    }
    .high-contrast .success-icon {
      color: #008000 !important; /* Green for success */
    }
    .high-contrast .lead {
      color: #ffffff !important;
    }
    .high-contrast .section-container {
      background: #000000 !important;
      border: 2px solid #ffffff !important;
    }
    .high-contrast a {
      color: #00b7eb !important;
    }
    .high-contrast a:hover {
      color: #ffff00 !important;
      text-decoration: underline;
      text-decoration-color: #ffff00;
      text-decoration-thickness: 2px;
    }
  </style>
</head>
<body>
  <%- include('partials/header') %>
  <main class="container py-5 text-center">
    <div class="section-container">
      <div class="card shadow fade-in">
        <div class="card-body">
          <i class="fas fa-check-circle success-icon"></i>
          <h2 class="section-title mb-4">Success!</h2>
          <p class="lead"><%= message %></p>
          <a href="/appointments" class="btn btn-primary"><i class="fas fa-arrow-left me-2"></i>Back to Appointments</a>
        </div>
      </div>
    </div>
  </main>
  <%- include('partials/footer') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    // Apply high contrast mode from localStorage
    document.addEventListener('DOMContentLoaded', () => {
      if (localStorage.getItem('highContrast') === 'true') {
        document.body.classList.add('high-contrast');
      }
    });

    // Initialize tooltips
    const tooltipTriggerList = document.querySelectorAll('[data-bs-toggle="tooltip"]');
    const tooltipList = [...tooltipTriggerList].map(tooltipTriggerEl => new bootstrap.Tooltip(tooltipTriggerEl));
  </script>
</body>
</html>