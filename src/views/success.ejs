<%
  const displayMessage =
    typeof message === 'string' && message.trim()
      ? message.trim()
      : 'Action completed successfully';

  const isError =
    /error|invalid|failed|cannot|not yours|already booked|please link|conflict/i.test(
      displayMessage
    );
%>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= isError ? 'Unable to Complete' : 'Success' %> - GPConnect</title>

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >
  <link
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
    rel="stylesheet"
  >
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
    rel="stylesheet"
  >
  <link href="/css/styles.css" rel="stylesheet">

  <style>
    :root {
      --primary: #4a6fa5;
      --secondary: #166088;
      --accent: #4fc3f7;
      --light: #f8f9fa;
      --dark: #212529;
      --success: #28a745;
      --error: #dc3545;
    }

    body {
      min-height: 100vh;
      overflow-x: hidden;
      background-color: var(--light);
      color: var(--dark);
      font-family: 'Poppins', sans-serif;
    }

    .section-container {
      margin-bottom: 2rem;
      padding: 2rem;
      border-radius: 16px;
      background: linear-gradient(
        135deg,
        rgba(74, 111, 165, 0.05),
        rgba(22, 96, 136, 0.05)
      );
    }

    .status-card {
      max-width: 600px;
      margin: 0 auto;
      border: none;
      border-radius: 16px;
      background-color: #ffffff;
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.1);
    }

    .status-card .card-body {
      padding: 2.5rem;
    }

    .status-icon {
      margin-bottom: 1.5rem;
      font-size: 3.5rem;
      animation: pulse 1.5s ease-in-out infinite;
    }

    .success-icon { color: var(--success); }
    .error-icon { color: var(--error); }

    .section-title {
      position: relative;
      display: inline-block;
      margin-bottom: 2rem;
      font-weight: 600;
      color: var(--primary);
    }

    .section-title::after {
      content: '';
      position: absolute;
      bottom: -10px;
      left: 50%;
      width: 80px;
      height: 4px;
      border-radius: 2px;
      background-color: var(--accent);
      transform: translateX(-50%);
    }

    .error-title { color: var(--error); }
    .error-title::after { background-color: var(--error); }

    .status-message {
      margin-bottom: 1.75rem;
      color: var(--dark);
      font-size: 1.25rem;
      line-height: 1.6;
    }

    .btn-primary {
      padding: 0.75rem 1.5rem;
      border-color: var(--primary);
      border-radius: 8px;
      background-color: var(--primary);
      font-weight: 500;
    }

    .btn-primary:hover,
    .btn-primary:focus {
      border-color: var(--secondary);
      background-color: var(--secondary);
    }

    .fade-in { animation: fadeIn 0.5s ease-in; }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }

    @keyframes pulse {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.08); }
    }

    body.high-contrast {
      background-color: #000000 !important;
      color: #ffffff !important;
    }

    body.high-contrast .section-container,
    body.high-contrast .status-card {
      border: 2px solid #ffffff !important;
      background: #000000 !important;
      color: #ffffff !important;
      box-shadow: none !important;
    }

    body.high-contrast .section-title,
    body.high-contrast .status-message {
      color: #ffffff !important;
    }

    body.high-contrast .section-title::after {
      background-color: #ffff00 !important;
    }

    body.high-contrast .success-icon { color: #00ff00 !important; }
    body.high-contrast .error-icon { color: #ff6666 !important; }

    body.high-contrast .btn-primary {
      border: 2px solid #ffffff !important;
      background-color: #0000ff !important;
      color: #ffffff !important;
    }

    body.high-contrast .btn-primary:hover,
    body.high-contrast .btn-primary:focus {
      border-color: #ffff00 !important;
      background-color: #000099 !important;
      color: #ffff00 !important;
    }

    @media (max-width: 576px) {
      .section-container { padding: 1rem; }
      .status-card .card-body { padding: 2rem 1.25rem; }
      .status-icon { font-size: 3rem; }
      .status-message { font-size: 1.05rem; }
      .btn-primary { width: 100%; }
    }

    @media (prefers-reduced-motion: reduce) {
      .fade-in,
      .status-icon { animation: none; }
    }
  </style>
</head>

<body>
  <%- include('partials/header') %>

  <main class="container py-5 text-center">
    <div class="section-container">
      <div
        class="card status-card fade-in"
        role="<%= isError ? 'alert' : 'status' %>"
        aria-live="polite"
      >
        <div class="card-body">
          <% if (isError) { %>
            <i
              class="fas fa-exclamation-circle status-icon error-icon"
              aria-hidden="true"
            ></i>
            <h1 class="section-title error-title">Unable to Complete</h1>
          <% } else { %>
            <i
              class="fas fa-check-circle status-icon success-icon"
              aria-hidden="true"
            ></i>
            <h1 class="section-title">Success!</h1>
          <% } %>

          <p class="status-message"><%= displayMessage %></p>

          <a href="/appointments?restoreSearch=true" class="btn btn-primary">
            <i class="fas fa-arrow-left me-2" aria-hidden="true"></i>
            Back to Appointments
          </a>
        </div>
      </div>
    </div>
  </main>

  <%- include('partials/footer') %>
</body>
</html>
