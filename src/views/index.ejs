<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Home - GP Connect | Modern Appointment System</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link href="/css/styles.css" rel="stylesheet">
  <style>
    :root {
      --primary: #4a6fa5;
      --secondary: #166088;
      --accent: #4fc3f7;
      --light: #f8f9fa;
      --dark: #212529;
    }

    body {
      font-family: 'Poppins', sans-serif;
      overflow-x: hidden;
    }

    .hero-section {
      background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
      color: white;
      padding: 5rem 0;
      position: relative;
      overflow: hidden;
    }

    .hero-section::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: url('data:image/svg+xml;base64,');
      opacity: 0.6;
      pointer-events: none;
    }

    .feature-card {
      transition: transform 0.3s ease, box-shadow 0.3s ease;
      border: none;
      border-radius: 12px;
      overflow: hidden;
      height: 100%;
    }

    .feature-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
    }

    .feature-icon {
      font-size: 2.5rem;
      color: var(--primary);
      margin-bottom: 1rem;
    }

    .btn-primary {
      background-color: var(--primary);
      border-color: var(--primary);
      padding: 0.75rem 2rem;
      font-weight: 500;
    }

    .btn-primary:hover {
      background-color: var(--secondary);
      border-color: var(--secondary);
    }

    .btn-outline-primary {
      color: var(--primary);
      border-color: var(--primary);
    }

    .btn-outline-primary:hover {
      background-color: var(--primary);
      color: white;
    }

    .section-title {
      position: relative;
      display: inline-block;
      margin-bottom: 2rem;
    }

    .section-title::after {
      content: '';
      position: absolute;
      bottom: -10px;
      left: 50%;
      transform: translateX(-50%);
      width: 60px;
      height: 3px;
      background-color: var(--accent);
    }

    .how-it-works-step {
      position: relative;
      padding-left: 3rem;
      margin-bottom: 2rem;
    }

    .step-number {
      position: absolute;
      left: 0;
      top: 0;
      width: 2.5rem;
      height: 2.5rem;
      background-color: var(--accent);
      color: white;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: bold;
    }

    .testimonial-card {
      border-left: 4px solid var(--accent);
    }

    .stats-item {
      text-align: center;
      padding: 1.5rem;
    }

    .stats-number {
      font-size: 2.5rem;
      font-weight: 700;
      color: var(--primary);
    }

    .stats-label {
      color: var(--secondary);
      font-weight: 500;
    }

    .cta-section {
      background-color: var(--light);
      position: relative;
      overflow: hidden;
    }

    .wave-shape {
      position: absolute;
      bottom: 0;
      left: 0;
      width: 100%;
      height: 100px;
      background: url('data:image/svg+xml;utf8,<svg viewBox="0 0 1200 120" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none"><path d="M0,0V46.29c47.79,22.2,103.59,32.17,158,28,70.36-5.37,136.33-33.31,206.8-37.5C438.64,32.43,512.34,53.67,583,72.05c69.27,18,138.3,24.88,209.4,13.08,36.15-6,69.85-17.84,104.45-29.34C989.49,25,1113-14.29,1200,52.47V0Z" fill="%23f8f9fa" opacity=".25"/><path d="M0,0V15.81C13,36.92,27.64,56.86,47.69,72.05,99.41,111.27,165,111,224.58,91.58c31.15-10.15,60.09-26.07,89.67-39.8,40.92-19,84.73-46,130.83-49.67,36.26-2.85,70.9,9.42,98.6,31.56,31.77,25.39,62.32,62,103.63,73,40.44,10.79,81.35-6.69,119.13-24.28s75.16-39,116.92-43.05c59.73-5.85,113.28,22.88,168.9,38.84,30.2,8.66,59,6.17,87.09-7.5,22.43-10.89,48-26.93,60.65-49.24V0Z" fill="%23f8f9fa" opacity=".5"/><path d="M0,0V5.63C149.93,59,314.09,71.32,475.83,42.57c43-7.64,84.23-20.12,127.61-26.46,59-8.63,112.48,12.24,165.56,35.4C827.93,77.22,886,95.24,951.2,90c86.53-7,172.46-45.71,248.8-84.81V0Z" fill="%23f8f9fa"/></svg>');
      background-size: cover;
      transform: rotate(180deg);
    }

    /* High Contrast Overrides */
    .high-contrast .hero-section,
    .high-contrast .btn-primary,
    .high-contrast .btn-outline-primary,
    .high-contrast .feature-card,
    .high-contrast .stats-number,
    .high-contrast .stats-label,
    .high-contrast .section-title::after,
    .high-contrast .how-it-works-step .step-number,
    .high-contrast .cta-section {
      background: #000000 !important;
      color: #ffffff !important;
      border-color: #ffffff !important;
    }
    .high-contrast .hero-section::before,
    .high-contrast .wave-shape {
      display: none !important;
    }
    .high-contrast .feature-icon {
      color: #ffff00 !important;
    }
    .high-contrast a {
      color: #00b7eb !important;
    }
    .high-contrast a:hover {
      color: #ffff00 !important;
    }
  </style>
</head>
<body>
  <%- include('partials/header') %>
  <!-- Hero Section -->
  <section class="hero-section">
    <div class="container">
      <div class="row align-items-center">
        <div class="col-lg-6">
          <h1 class="display-4 fw-bold mb-4">Smart GP Appointments Made Simple</h1>
          <p class="lead mb-4">Book, manage, and sync your doctor appointments with our intuitive platform. Real-time availability across all city practices.</p>
          <div class="d-flex gap-3">
            <a href="/appointments" class="btn btn-light btn-lg px-4">
              <i class="fas fa-calendar-check me-2"></i>Book Now
            </a>
            <a href="/register" class="btn btn-outline-light btn-lg px-4">
              <i class="fas fa-user-plus me-2"></i>Register
            </a>
          </div>
        </div>
        <div class="col-lg-6 d-none d-lg-block">
          <img
            src="/images/doctor-appointment.webp"
            alt="Doctor appointment illustration"
            class="img-fluid"
          >
        </div>
      </div>
    </div>
  </section>
  <!-- Features Section -->
  <section class="py-5">
    <div class="container py-5">
      <h2 class="text-center section-title">Key Features</h2>
      <p class="text-center lead mb-5">Everything you need for seamless healthcare scheduling</p>
      <div class="row g-4">
        <!-- Feature 1 -->
        <div class="col-md-6 col-lg-4">
          <div class="feature-card card p-4">
            <div class="feature-icon">
              <i class="fas fa-search"></i>
            </div>
            <h3>City-Wide Availability</h3>
            <p>View and compare available appointments across all GP practices in your area in real-time.</p>
          </div>
        </div>
        <!-- Feature 2 -->
        <div class="col-md-6 col-lg-4">
          <div class="feature-card card p-4">
            <div class="feature-icon">
              <i class="fas fa-exchange-alt"></i>
            </div>
            <h3>Appointment Swapping</h3>
            <p>Need a different time? Request to swap appointments with other patients securely.</p>
          </div>
        </div>
        <!-- Feature 3 -->
        <div class="col-md-6 col-lg-4">
          <div class="feature-card card p-4">
            <div class="feature-icon">
              <i class="fas fa-calendar-alt"></i>
            </div>
            <h3>Calendar Sync</h3>
            <p>Automatically sync your appointments with Google Calendar for better time management.</p>
          </div>
        </div>
        <!-- Feature 4 -->
        <div class="col-md-6 col-lg-4">
          <div class="feature-card card p-4">
            <div class="feature-icon">
              <i class="fas fa-bell"></i>
            </div>
            <h3>Smart Reminders</h3>
            <p>Get timely notifications about upcoming appointments and important follow-ups.</p>
          </div>
        </div>
        <!-- Feature 5 -->
        <div class="col-md-6 col-lg-4">
          <div class="feature-card card p-4">
            <div class="feature-icon">
              <i class="fas fa-user-md"></i>
            </div>
            <h3>GP Preferences</h3>
            <p>Save your preferred doctors and get priority notifications when they have availability.</p>
          </div>
        </div>
        <!-- Feature 6 -->
        <div class="col-md-6 col-lg-4">
          <div class="feature-card card p-4">
            <div class="feature-icon">
              <i class="fas fa-lightbulb"></i>
            </div>
            <h3>Intelligent Scheduling</h3>
            <p>Our system suggests optimal appointment times based on your history and preferences.</p>
          </div>
        </div>
      </div>
    </div>
  </section>
  <!-- How It Works Section -->
  <section class="py-5 bg-light">
    <div class="container py-5">
      <h2 class="text-center section-title">How It Works</h2>
      <p class="text-center lead mb-5">Get started in just a few simple steps</p>
      <div class="row">
        <div class="col-lg-10 mx-auto">
          <div class="how-it-works-step">
            <div class="step-number">1</div>
            <h3>Create Your Account</h3>
            <p>Register securely with your email and set up your profile. It takes less than a minute.</p>
          </div>
          <div class="how-it-works-step">
            <div class="step-number">2</div>
            <h3>Find Available Appointments</h3>
            <p>Browse real-time availability across all participating GP practices in your city.</p>
          </div>
          <div class="how-it-works-step">
            <div class="step-number">3</div>
            <h3>Book Your Preferred Slot</h3>
            <p>Select your GP and time slot. Our system checks for calendar conflicts before confirming.</p>
          </div>
          <div class="how-it-works-step">
            <div class="step-number">4</div>
            <h3>Manage Your Appointments</h3>
            <p>Cancel, reschedule, or swap appointments as needed. Changes update in real-time.</p>
          </div>
        </div>
      </div>
    </div>
  </section>
  <!-- Stats Section -->
  <section class="py-5">
    <div class="container py-5">
      <div class="row g-4">
        <div class="col-md-3">
          <div class="stats-item">
            <div class="stats-number" data-count="10000">0</div>
            <div class="stats-label">Appointments Booked</div>
          </div>
        </div>
        <div class="col-md-3">
          <div class="stats-item">
            <div class="stats-number" data-count="150">0</div>
            <div class="stats-label">Participating GPs</div>
          </div>
        </div>
        <div class="col-md-3">
          <div class="stats-item">
            <div class="stats-number" data-count="95">0</div>
            <div class="stats-label">% Satisfaction Rate</div>
          </div>
        </div>
        <div class="col-md-3">
          <div class="stats-item">
            <div class="stats-number" data-count="24">0</div>
            <div class="stats-label">Hour Support</div>
          </div>
        </div>
      </div>
    </div>
  </section>
  <!-- CTA Section -->
  <section class="cta-section py-5 position-relative">
    <div class="container py-5 text-center">
      <h2 class="display-5 fw-bold mb-4">Ready to Experience Better Healthcare Scheduling?</h2>
      <p class="lead mb-5">Join thousands of patients who have simplified their GP appointments.</p>
      <a href="/register" class="btn btn-primary btn-lg px-5">
        <i class="fas fa-rocket me-2"></i>Get Started Now
      </a>
    </div>
    <div class="wave-shape"></div>
  </section>
  <%- include('partials/footer') %>
  <script>
    // Simple counter animation for stats
    document.addEventListener('DOMContentLoaded', function () {
      const counters = document.querySelectorAll('.stats-number');
      const speed = 200;

      counters.forEach(counter => {
        const target = +counter.getAttribute('data-count');
        const count = +counter.innerText;
        const increment = target / speed;

        if (count < target) {
          counter.innerText = Math.ceil(count + increment);
          setTimeout(updateCount, 1);
        } else {
          counter.innerText = target;
        }

        function updateCount() {
          const count = +counter.innerText;
          const increment = target / speed;

          if (count < target) {
            counter.innerText = Math.ceil(count + increment);
            setTimeout(updateCount, 1);
          } else {
            counter.innerText = target;
          }
        }
      });

      // Apply high contrast mode from localStorage
      if (localStorage.getItem('highContrast') === 'true') {
        document.body.classList.add('high-contrast');
      }
    });
  </script>
</body>
</html>