<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login - GP Appointment System</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
  <link href="/css/styles.css" rel="stylesheet">
  <style>
    /* High Contrast Overrides */
    .high-contrast body {
      background-color: #000000 !important;
      color: #ffffff !important;
    }
    .high-contrast .card {
      background-color: #000000 !important;
      border: 2px solid #ffffff !important;
      color: #ffffff !important;
    }
    .high-contrast .card-header {
      background-color: #0000ff !important;
      color: #ffffff !important;
      border-bottom: 2px solid #ffffff !important;
    }
    .high-contrast .form-control {
      background-color: #000000 !important;
      color: #ffffff !important;
      border: 2px solid #ffffff !important;
    }
    .high-contrast .form-control:focus {
      border-color: #ffff00 !important;
      box-shadow: none !important;
    }
    .high-contrast .btn-primary {
      background-color: #0000ff !important;
      border-color: #ffffff !important;
      color: #ffffff !important;
    }
    .high-contrast .btn-primary:hover {
      background-color: #000099 !important;
      color: #ffff00 !important;
    }
    .high-contrast .alert {
      background-color: #000000 !important;
      color: #ffffff !important;
      border: 2px solid #ffffff !important;
    }
    .high-contrast a {
      color: #00b7eb !important;
    }
    .high-contrast a:hover {
      color: #ffff00 !important;
      text-decoration: underline;
      text-decoration-color: #ffff00;
      text-decoration-thickness: 2px;
    }
  </style>
</head>
<body>
  <%- include('partials/header') %>
  <main class="container py-5">
    <div class="row justify-content-center">
      <div class="col-md-6 col-lg-4">
        <div class="card shadow">
          <div class="card-header">
            <h4 class="mb-0">Login</h4>
          </div>
          <div class="card-body">
            <% if (error) { %>
              <div class="alert alert-danger" role="alert"><%= error %></div>
            <% } %>
            <form method="POST" action="/api/users/login" id="loginForm">
              <div class="mb-3">
                <label for="email" class="form-label">Email</label>
                <input type="email" class="form-control" id="email" name="email" required aria-describedby="emailHelp">
              </div>
              <div class="mb-3">
                <label for="password" class="form-label">Password</label>
                <input type="password" class="form-control" id="password" name="password" required>
              </div>
              <button type="submit" class="btn btn-primary w-100"><i class="fas fa-sign-in-alt me-2"></i>Login</button>
            </form>
            <p class="text-center mt-3">Don't have an account? <a href="/register">Register</a></p>
          </div>
        </div>
      </div>
    </div>
  </main>
  <%- include('partials/footer') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    // Apply high contrast mode from localStorage
    document.addEventListener('DOMContentLoaded', () => {
      if (localStorage.getItem('highContrast') === 'true') {
        document.body.classList.add('high-contrast');
      }
    });

    // Client-side validation
    document.getElementById('loginForm').addEventListener('submit', function(e) {
      const email = document.getElementById('email').value;
      const password = document.getElementById('password').value;
      if (!email.includes('@') || password.length < 6) {
        e.preventDefault();
        alert('Please enter a valid email and a password with at least 6 characters.');
      }
    });
  </script>
  <script>
  // Check for high contrast mode in localStorage and apply styles
  document.addEventListener('DOMContentLoaded', () => {
    if (localStorage.getItem('highContrast') === 'true') {
      document.body.classList.add('high-contrast');
      document.body.style.backgroundColor = '#000000';
      console.log('High contrast mode enabled: body background set to #000000');
    }
  });
</script>

</body>
</html>