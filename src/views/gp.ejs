<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>GP Dashboard - GP Connect</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link href="/css/styles.css" rel="stylesheet">
  <style>
    :root {
      --primary: #4a6fa5;
      --secondary: #166088;
      --accent: #4fc3f7;
      --light: #f8f9fa;
      --dark: #212529;
    }
    body {
      font-family: 'Poppins', sans-serif;
      background-color: var(--light);
      overflow-x: hidden;
    }
    .section-title {
      position: relative;
      display: inline-block;
      margin-bottom: 2.5rem;
      font-weight: 600;
      color: var(--primary);
    }
    .section-title::after {
      content: '';
      position: absolute;
      bottom: -10px;
      left: 50%;
      transform: translateX(-50%);
      width: 80px;
      height: 4px;
      background-color: var(--accent);
      border-radius: 2px;
    }
    .card {
      border: none;
      border-radius: 16px;
      box-shadow: 0 6px 20px rgba(0,0,0,0.1);
      transition: transform 0.3s ease, box-shadow 0.3s ease;
      background-color: white;
    }
    .card:hover {
      transform: translateY(-8px);
      box-shadow: 0 12px 30px rgba(0,0,0,0.15);
    }
    .btn-primary {
      background-color: var(--primary);
      border-color: var(--primary);
      padding: 0.75rem 1.5rem;
      font-weight: 500;
      border-radius: 8px;
      transition: background-color 0.3s ease;
    }
    .btn-primary:hover {
      background-color: var(--secondary);
      border-color: var(--secondary);
    }
    .alert {
      border-radius: 10px;
      border-left: 5px solid;
      padding: 1rem;
      margin-bottom: 2rem;
    }
    .alert-warning {
      border-color: #ffca2c;
      background-color: #fff3cd;
    }
    .alert-danger {
      border-color: #dc3545;
      background-color: #f8d7da;
    }
    .item-card {
      border-radius: 12px;
      padding: 1.5rem;
      background-color: #fff;
      margin-bottom: 1.5rem;
      border-left: 4px solid var(--accent);
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .item-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 8px 20px rgba(0,0,0,0.1);
    }
    .item-header {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin-bottom: 1rem;
    }
    .item-header i {
      font-size: 1.8rem;
      color: var(--primary);
    }
    .item-header h6 {
      margin: 0;
      font-weight: 600;
      color: var(--dark);
    }
    .star-rating .fa-star {
      color: #ffca2c;
      font-size: 1.2rem;
    }
    .star-rating .fa-regular.fa-star {
      color: #ced4da;
      font-size: 1.2rem;
    }
    .section-container {
      background: linear-gradient(135deg, rgba(74, 111, 165, 0.05), rgba(22, 96, 136, 0.05));
      padding: 2rem;
      border-radius: 16px;
      margin-bottom: 2rem;
    }
    .fade-in {
      animation: fadeIn 0.5s ease-in;
    }
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }
    /* High Contrast Overrides */
    .high-contrast body {
      background-color: #000000 !important;
      color: #ffffff !important;
    }
    .high-contrast .section-title {
      color: #ffffff !important;
    }
    .high-contrast .section-title::after {
      background-color: #ffff00 !important;
    }
    .high-contrast .card {
      background-color: #000000 !important;
      border: 2px solid #ffffff !important;
      color: #ffffff !important;
      box-shadow: none !important;
    }
    .high-contrast .card-header {
      background-color: #0000ff !important;
      color: #ffffff !important;
      border-bottom: 2px solid #ffffff !important;
    }
    .high-contrast .btn-primary {
      background-color: #0000ff !important;
      border-color: #ffffff !important;
      color: #ffffff !important;
    }
    .high-contrast .btn-primary:hover {
      background-color: #000099 !important;
      color: #ffff00 !important;
    }
    .high-contrast .alert {
      background-color: #000000 !important;
      color: #ffffff !important;
      border-color: #ffffff !important;
    }
    .high-contrast .alert-warning {
      border-left-color: #ffa500 !important; /* Orange for warning */
    }
    .high-contrast .alert-danger {
      border-left-color: #ff0000 !important; /* Red for danger */
    }
    .high-contrast .alert-link {
      color: #00b7eb !important;
    }
    .high-contrast .alert-link:hover {
      color: #ffff00 !important;
      text-decoration: underline;
      text-decoration-color: #ffff00;
      text-decoration-thickness: 2px;
    }
    .high-contrast .item-card {
      background-color: #000000 !important;
      border-left-color: #ffff00 !important;
      color: #ffffff !important;
    }
    .high-contrast .item-header i {
      color: #ffff00 !important;
    }
    .high-contrast .item-header h6 {
      color: #ffffff !important;
    }
    .high-contrast .star-rating .fa-star {
      color: #ffa500 !important; /* Orange for stars */
    }
    .high-contrast .star-rating .fa-regular.fa-star {
      color: #ffffff !important;
    }
    .high-contrast .section-container {
      background: #000000 !important;
      border: 2px solid #ffffff !important;
    }
    .high-contrast .text-muted {
      color: #ffffff !important;
    }
    .high-contrast a {
      color: #00b7eb !important;
    }
    .high-contrast a:hover {
      color: #ffff00 !important;
      text-decoration: underline;
      text-decoration-color: #ffff00;
      text-decoration-thickness: 2px;
    }
  </style>
</head>
<body>
  <%- include('partials/header') %>
  <main class="container py-5">
    <h2 class="text-center section-title mb-5">GP Dashboard</h2>

    <% if (!user || user.role !== 'gp') { %>
      <div class="alert alert-warning fade-in" role="alert">
        <i class="fas fa-exclamation-triangle me-2"></i>
        Access denied. Please <a href="/login" class="alert-link">log in</a> as a GP.
      </div>
    <% } else { %>
      <% if (error) { %>
        <div class="alert alert-danger fade-in" role="alert">
          <i class="fas fa-times-circle me-2"></i>
          <%= error %>
        </div>
      <% } %>

      <!-- GP's Scheduled Appointments -->
      <div class="section-container">
        <div class="card shadow mb-5">
          <div class="card-header bg-light">
            <h5 class="mb-0"><i class="fas fa-calendar-alt me-2"></i>Scheduled Appointments</h5>
          </div>
          <div class="card-body">
            <% if (appointments && appointments.length > 0) { %>
              <div class="row g-4">
                <% appointments.forEach(appt => { %>
                  <div class="col-md-6 col-lg-4">
                    <div class="item-card fade-in">
                      <div class="item-header">
                        <i class="fas fa-user"></i>
                        <h6><%= appt.user_name || 'Unknown' %></h6>
                      </div>
                      <p><i class="fas fa-map-marker-alt me-2"></i><strong>City:</strong> <%= appt.city %></p>
                      <p><i class="fas fa-clock me-2"></i><strong>Time:</strong> <%= new Date(appt.start_time).toLocaleString() %></p>
                    </div>
                  </div>
                <% }) %>
              </div>
            <% } else { %>
              <p class="text-muted"><i class="fas fa-info-circle me-2"></i>No scheduled appointments.</p>
            <% } %>
          </div>
        </div>
      </div>

      <!-- Feedback for GP -->
      <div class="section-container">
        <div class="card shadow">
          <div class="card-header bg-light">
            <h5 class="mb-0"><i class="fas fa-star me-2"></i>Feedback for Your Appointments</h5>
          </div>
          <div class="card-body">
            <% if (feedback && feedback.length > 0) { %>
              <div class="row g-4">
                <% feedback.forEach(fb => { %>
                  <div class="col-md-6 col-lg-4">
                    <div class="item-card fade-in">
                      <div class="item-header">
                        <i class="fas fa-user"></i>
                        <h6><%= fb.user_name %></h6>
                      </div>
                      <p><i class="fas fa-calendar-alt me-2"></i><strong>Appointment:</strong> <%= new Date(fb.start_time).toLocaleString() %></p>
                      <p>
                        <strong>Rating:</strong>
                        <span class="star-rating">
                          <% for (let i = 1; i <= 5; i++) { %>
                            <i class="fa-star <%= i <= fb.rating ? 'fas' : 'far' %>"></i>
                          <% } %>
                        </span>
                      </p>
                      <p><i class="fas fa-comment me-2"></i><strong>Comments:</strong> <%= fb.comments || 'No comments' %></p>
                    </div>
                  </div>
                <% }) %>
              </div>
            <% } else { %>
              <p class="text-muted"><i class="fas fa-info-circle me-2"></i>No feedback available.</p>
            <% } %>
          </div>
        </div>
      </div>
    <% } %>
  </main>
  <%- include('partials/footer') %>
  <script>
    // Apply high contrast mode from localStorage
    document.addEventListener('DOMContentLoaded', () => {
      if (localStorage.getItem('highContrast') === 'true') {
        document.body.classList.add('high-contrast');
      }
    });

    // Initialize tooltips
    const tooltipTriggerList = document.querySelectorAll('[data-bs-toggle="tooltip"]');
    const tooltipList = [...tooltipTriggerList].map(tooltipTriggerEl => new bootstrap.Tooltip(tooltipTriggerEl));
  </script>
  <script>
  // Check for high contrast mode in localStorage and apply styles
  document.addEventListener('DOMContentLoaded', () => {
    if (localStorage.getItem('highContrast') === 'true') {
      document.body.classList.add('high-contrast');
      document.body.style.backgroundColor = '#000000';
      console.log('High contrast mode enabled: body background set to #000000');
    }
  });
</script>

</body>
</html>