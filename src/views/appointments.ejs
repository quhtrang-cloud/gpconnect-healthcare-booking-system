                            <!-- Swap Appointments Section -->
<div class="card shadow-sm">
  <div class="card-header bg-warning bg-opacity-10">
    <h5 class="mb-0 text-warning">
      <i class="fas fa-exchange-alt me-2"></i>
      Appointment Swap Requests
    </h5>
  </div>

  <div class="card-body">
    <form method="POST" action="/api/appointments/swap" id="swapForm">
      <div class="row g-3">

        <div class="col-md-6">
          <label for="myAppointment" class="form-label">
            Your Appointment
          </label>

          <select
            class="form-select"
            id="myAppointment"
            name="my_appointment_id"
            required
            data-bs-toggle="tooltip"
            title="Select your booked appointment"
          >
            <option value="" disabled selected>
              Loading your appointments...
            </option>
          </select>
        </div>

        <div class="col-md-6">
          <label for="targetAppointment" class="form-label">
            Target Appointment
          </label>

          <select
            class="form-select"
            id="targetAppointment"
            name="target_appointment_id"
            required
            disabled
            data-bs-toggle="tooltip"
            title="Select the appointment you want to swap with"
          >
            <option value="" disabled selected>
              Select your appointment first
            </option>
          </select>
        </div>

        <div class="col-12">
          <button
            type="submit"
            class="btn btn-warning"
            id="swapSubmitButton"
            disabled
            data-bs-toggle="tooltip"
            title="Submit a swap request"
          >
            <i class="fas fa-exchange-alt me-2"></i>
            Request Swap
          </button>
        </div>

      </div>
    </form>

    <div
      id="swapMessage"
      class="alert alert-info mt-3 d-none"
      role="alert"
    ></div>
  </div>
</div>

<!-- Logout Button -->
