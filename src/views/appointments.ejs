                              <a href="/api/users/logout" class="btn btn-outline-danger" data-bs-toggle="tooltip"
                                title="Log out of your account"><i class="fas fa-sign-out-alt me-2"></i>Logout</a>
                            </div>
                            <% } %>
    </main>
    <%- include('partials/footer') %>
      <script>
        // Apply high contrast mode from localStorage
        document.addEventListener('DOMContentLoaded', () => {
          if (localStorage.getItem('highContrast') === 'true') {
            document.body.classList.add('high-contrast');
            document.body.style.backgroundColor = '#000000';
            console.log('High contrast mode enabled: body background set to #000000');
          }

          // Automatically mark notifications as read
          const notificationForms = document.querySelectorAll('form[action="/api/appointments/mark-notification-read"]');
          notificationForms.forEach(form => {
            const formData = new URLSearchParams();
            const notificationId = form.querySelector('input[name="notification_id"]').value;
            formData.append('notification_id', notificationId);

            fetch('/api/appointments/mark-notification-read', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/x-www-form-urlencoded'
              },
              body: formData
            }).then(response => {
              if (!response.ok) {
                console.error('Failed to mark notification as read:', notificationId);
              }
            }).catch(error => {
              console.error('Error marking notification as read:', error);
            });
          });
        });

        // Initialize tooltips
        const tooltipTriggerList = document.querySelectorAll('[data-bs-toggle="tooltip"]');
        const tooltipList = [...tooltipTriggerList].map(tooltipTriggerEl => new bootstrap.Tooltip(tooltipTriggerEl));

        // Update form action and hidden input based on recommend toggle
        const form = document.getElementById('appointmentForm');
        const recommendToggle = document.getElementById('recommendToggle');
        const recommendInput = document.getElementById('recommend');
        const submitButton = form.querySelector('button[type="submit"]');
        const citySelect = document.getElementById('city');
        const practiceSelect = document.getElementById('practice_id');
        const allPractices = <%- JSON.stringify(practices || []) %>;

        function updateFormAction() {
          const intelligentFields =
            document.querySelectorAll('.intelligent-only');

          if (recommendToggle.checked) {
            form.action = '/api/appointments/recommend';
            recommendInput.value = 'true';
            submitButton.innerHTML =
              '<i class="fas fa-brain me-2"></i>Get Recommendations';

            intelligentFields.forEach(field => {
              field.disabled = false;
            });
          } else {
            form.action = '/api/appointments/availability';
            recommendInput.value = 'false';
            submitButton.innerHTML =
              '<i class="fas fa-search me-2"></i>Find Appointments';

            intelligentFields.forEach(field => {
              field.disabled = true;
            });
          }
        }

        // Filter practices based on selected city
        function updatePracticeOptions() {
          const selectedCity = citySelect.value;
          const practiceOptions = allPractices.filter(practice => !selectedCity || practice.city === selectedCity);
          practiceSelect.innerHTML = '<option value="" <%= !selectedPractice ? "selected" : "" %>>Any Practice</option>';
          practiceOptions.forEach(practice => {
            const option = document.createElement('option');
            option.value = practice.id;
            option.textContent = `${practice.name} (${practice.city})`;
            if (practice.id === '<%= selectedPractice %>') {
              option.selected = true;
            }
            practiceSelect.appendChild(option);
          });
        }

        // Keep the user's search choices while navigating to conflict/sync pages.
        const appointmentSearchStorageKey = 'gpconnectAppointmentSearch';

        function getAppointmentSearchState() {
          return {
            city: citySelect.value,
            practiceId: practiceSelect.value,
            gpId: document.getElementById('gp_id').value,
            date: document.getElementById('date').value,
            preferredTime: document.getElementById('preferredTime').value,
            symptomCategory: document.getElementById('symptomCategory').value,
            symptomDuration: document.getElementById('symptomDuration').value,
            severePain: document.getElementById('redFlagSeverePain').checked,
            breathing: document.getElementById('redFlagBreathing').checked,
            highFever: document.getElementById('redFlagFever').checked,
            otherRedFlag: document.getElementById('redFlagOther').checked,
            recommended: recommendToggle.checked
          };
        }

        function saveAppointmentSearchState() {
          try {
            sessionStorage.setItem(
              appointmentSearchStorageKey,
              JSON.stringify(getAppointmentSearchState())
            );
          } catch (error) {
            console.warn('Unable to save appointment search state:', error);
          }
        }

        function restoreAppointmentSearchState() {
          try {
            const savedValue = sessionStorage.getItem(appointmentSearchStorageKey);
            if (!savedValue) return false;

            const state = JSON.parse(savedValue);
            citySelect.value = state.city || '';
            updatePracticeOptions();
            practiceSelect.value = state.practiceId || '';
            document.getElementById('gp_id').value = state.gpId || '';
            document.getElementById('date').value = state.date || '';
            document.getElementById('preferredTime').value = state.preferredTime || '';
            document.getElementById('symptomCategory').value = state.symptomCategory || '';
            document.getElementById('symptomDuration').value = state.symptomDuration || '';
            document.getElementById('redFlagSeverePain').checked = Boolean(state.severePain);
            document.getElementById('redFlagBreathing').checked = Boolean(state.breathing);
            document.getElementById('redFlagFever').checked = Boolean(state.highFever);
            document.getElementById('redFlagOther').checked = Boolean(state.otherRedFlag);
            recommendToggle.checked = Boolean(state.recommended);
            updateFormAction();
            return true;
          } catch (error) {
            console.warn('Unable to restore appointment search state:', error);
            sessionStorage.removeItem(appointmentSearchStorageKey);
            return false;
          }
        }

        // Load swap appointments independently from the search results
const myAppointmentSelect =
  document.getElementById('myAppointment');

const targetAppointmentSelect =
  document.getElementById('targetAppointment');

const swapSubmitButton =
  document.getElementById('swapSubmitButton');

const swapMessage =
  document.getElementById('swapMessage');

function formatSwapAppointment(appt) {
  const date = new Date(appt.start_time);

  const dateText = date.toLocaleDateString();
  const timeText = date.toLocaleTimeString([], {
    hour: '2-digit',
    minute: '2-digit'
  });

  return `${appt.gp_name} (${appt.specialization || 'General'}) - ` +
    `${appt.practice_name} (${appt.city}) - ${dateText} ${timeText}`;
}

function showSwapMessage(message, type = 'info') {
  if (!swapMessage) {
    return;
  }

  swapMessage.className = `alert alert-${type} mt-3`;
  swapMessage.textContent = message;
}

function hideSwapMessage() {
  if (!swapMessage) {
    return;
  }

  swapMessage.className = 'alert alert-info mt-3 d-none';
  swapMessage.textContent = '';
}

async function loadMySwapAppointments() {
  if (!myAppointmentSelect) {
    return;
  }

  myAppointmentSelect.innerHTML = `
    <option value="" disabled selected>
      Loading your appointments...
    </option>
  `;

  targetAppointmentSelect.disabled = true;
  swapSubmitButton.disabled = true;

  try {
    const response = await fetch('/api/appointments/swap-options');

    if (!response.ok) {
      throw new Error('Unable to load your appointments');
    }

    const data = await response.json();
    const appointments = data.appointments || [];

    myAppointmentSelect.innerHTML = `
      <option value="" disabled selected>
        Select Your Appointment
      </option>
    `;

    if (appointments.length === 0) {
      const option = document.createElement('option');
      option.value = '';
      option.disabled = true;
      option.textContent = 'No upcoming booked appointments';

      myAppointmentSelect.appendChild(option);

      showSwapMessage(
        'You need an upcoming booked appointment before you can request a swap.',
        'warning'
      );

      return;
    }

    appointments.forEach(appt => {
      const option = document.createElement('option');

      option.value = appt.id;
      option.dataset.city = appt.city;
      option.textContent = formatSwapAppointment(appt);

      myAppointmentSelect.appendChild(option);
    });

    hideSwapMessage();
  } catch (error) {
    console.error('Error loading your swap appointments:', error);

    myAppointmentSelect.innerHTML = `
      <option value="" disabled selected>
        Unable to load appointments
      </option>
    `;

    showSwapMessage(
      'Unable to load your appointments for swapping.',
      'danger'
    );
  }
}

async function updateTargetAppointments() {
  if (!myAppointmentSelect || !targetAppointmentSelect) {
    return;
  }

  const selectedOption =
    myAppointmentSelect.options[myAppointmentSelect.selectedIndex];

  const selectedAppointmentId =
    myAppointmentSelect.value;

  const selectedCity =
    selectedOption?.dataset?.city || '';

  targetAppointmentSelect.innerHTML = `
    <option value="" disabled selected>
      Loading target appointments...
    </option>
  `;

  targetAppointmentSelect.disabled = true;
  swapSubmitButton.disabled = true;
  hideSwapMessage();

  if (!selectedAppointmentId || !selectedCity) {
    targetAppointmentSelect.innerHTML = `
      <option value="" disabled selected>
        Select your appointment first
      </option>
    `;
    return;
  }

  try {
    const params = new URLSearchParams({
      city: selectedCity,
      exclude_id: selectedAppointmentId
    });

    const response = await fetch(
      `/api/appointments/swap-targets?${params.toString()}`
    );

    if (!response.ok) {
      throw new Error('Unable to load target appointments');
    }

    const data = await response.json();
    const appointments = data.appointments || [];

    targetAppointmentSelect.innerHTML = `
      <option value="" disabled selected>
        Select Target Appointment
      </option>
    `;

    if (appointments.length === 0) {
      const option = document.createElement('option');

      option.value = '';
      option.disabled = true;
      option.textContent = 'No matching appointments available';

      targetAppointmentSelect.appendChild(option);

      showSwapMessage(
        `There are no other users' booked appointments available in ${selectedCity}.`,
        'info'
      );

      return;
    }

    appointments.forEach(appt => {
      const option = document.createElement('option');

      option.value = appt.id;
      option.dataset.city = appt.city;
      option.textContent = formatSwapAppointment(appt);

      targetAppointmentSelect.appendChild(option);
    });

    targetAppointmentSelect.disabled = false;
    hideSwapMessage();
  } catch (error) {
    console.error('Error loading target appointments:', error);

    targetAppointmentSelect.innerHTML = `
      <option value="" disabled selected>
        Unable to load target appointments
      </option>
    `;

    showSwapMessage(
      'Unable to load target appointments. Please try again.',
      'danger'
    );
  }
}

myAppointmentSelect?.addEventListener(
  'change',
  updateTargetAppointments
);

targetAppointmentSelect?.addEventListener(
  'change',
  () => {
    swapSubmitButton.disabled =
      !targetAppointmentSelect.value;
  }
);

citySelect.addEventListener('change', updatePracticeOptions);
        recommendToggle.addEventListener('change', updateFormAction);

        // Set initial form action and practice options on page load
        updateFormAction();
        updatePracticeOptions();
        const appointmentSearchWasRestored = restoreAppointmentSearchState();
        loadMySwapAppointments();

        // Prevent default form submission and handle manually
        form.addEventListener('submit', function (e) {
          e.preventDefault();
          const city = document.getElementById('city').value;
          const date = document.getElementById('date').value;
          if (!city || !date) {
            alert('Please select a city and date.');
            return;
          }
          saveAppointmentSearchState();
          const formData = new URLSearchParams();
          formData.append('city', city);
          formData.append('practice_id', document.getElementById('practice_id').value);
          formData.append('date', date);
          formData.append('gp_id', document.getElementById('gp_id').value);
          formData.append('preferred_time', recommendToggle.checked ? document.getElementById('preferredTime').value : '');
          formData.append('symptom_category', document.getElementById('symptomCategory').value);
          formData.append('symptom_duration', recommendToggle.checked ? document.getElementById('symptomDuration').value : '');
          formData.append('red_flags[severe_pain]', recommendToggle.checked && document.getElementById('redFlagSeverePain').checked);
          formData.append('red_flags[breathing]', recommendToggle.checked && document.getElementById('redFlagBreathing').checked);
          formData.append('red_flags[high_fever]', recommendToggle.checked && document.getElementById('redFlagFever').checked);
          formData.append('red_flags[other]', recommendToggle.checked && document.getElementById('redFlagOther').checked);
          formData.append('recommend', recommendInput.value);

          fetch(form.action, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/x-www-form-urlencoded'
            },
            body: formData
          }).then(response => {
            if (response.ok) {
              return response.text();
            } else {
              throw new Error('Request failed with status ' + response.status);
            }
          }).then(html => {
            document.open();
            document.write(html);
            document.close();
          }).catch(error => {
            console.error('Fetch error:', error);
            alert('Error processing request: ' + error.message);
          });
        });

        // Save the current search before actions that navigate away from this page.
        document.addEventListener('submit', event => {
          const action = event.target?.getAttribute?.('action');
          if (
            action === '/api/appointments/check-conflicts' ||
            action === '/api/calendar/sync' ||
            action === '/api/appointments/book'
          ) {
            saveAppointmentSearchState();
          }
        }, true);

        // The status page adds restoreSearch=true to its Back button.
        const currentUrl = new URL(window.location.href);
        if (
          currentUrl.searchParams.get('restoreSearch') === 'true' &&
          appointmentSearchWasRestored &&
          citySelect.value &&
          document.getElementById('date').value
        ) {
          currentUrl.searchParams.delete('restoreSearch');
          window.history.replaceState({}, '', currentUrl.pathname + currentUrl.search);
          window.setTimeout(() => form.requestSubmit(), 0);
        }

        // Client-side validation for swap form
        document.getElementById('swapForm')?.addEventListener('submit', function (e) {
          const myAppt = document.getElementById('myAppointment')?.value;
          const targetAppt = document.getElementById('targetAppointment')?.value;

          if (!myAppt || !targetAppt) {
            e.preventDefault();
            alert('Please select both appointments.');
            return;
          }

          if (String(myAppt) === String(targetAppt)) {
            e.preventDefault();
            alert('Cannot swap with the same appointment.');
          }
        });

        // Auto-refresh appointments every 30 seconds
        function refreshAppointments() {
          const city = document.getElementById('city').value;
          const practice_id = document.getElementById('practice_id').value;
          const date = document.getElementById('date').value;
          const gp_id = document.getElementById('gp_id').value;
          const symptom_category = document.getElementById('symptomCategory').value;
          if (city && date) {
            fetch(`/api/appointments/availability?city=${encodeURIComponent(city)}&practice_id=${encodeURIComponent(practice_id)}&date=${encodeURIComponent(date)}&gp_id=${encodeURIComponent(gp_id)}&symptom_category=${encodeURIComponent(symptom_category)}`)
              .then(response => response.text())
              .then(html => {
                const parser = new DOMParser();
                const doc = parser.parseFromString(html, 'text/html');
                const newAppointments = doc.querySelector('.table-responsive');
                if (newAppointments) {
                  document.querySelector('.table-responsive')?.replaceWith(newAppointments);
                }
              });
          }
        }
        setInterval(refreshAppointments, 30000);
      </script>
</body>

</html>
